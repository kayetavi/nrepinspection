rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Equipment collection:
    // Read & write allowed so real-time synchronization, Excel uploads, and edits work seamlessly
    match /equipment/{equipmentId} {
      allow read, write: if true;
    }

    // User profiles collection:
    // Read & write allowed so users registry, pre-authorization, and role administration work without friction
    match /users/{userId} {
      allow read, write: if true;
    }

    // Admins lookup collection:
    match /admins/{userId} {
      allow read, write: if true;
    }

    // Audit logs collection:
    match /audit_logs/{logId} {
      allow read, write: if true;
    }
  }
}
